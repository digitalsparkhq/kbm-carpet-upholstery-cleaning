---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Almost Done | KBM Cleaning Services"
  description="Please complete your enquiry by sending us a WhatsApp."
  robots="noindex, nofollow"
>
  <section class="min-h-[85vh] flex items-center justify-center bg-brand-navy px-6 relative overflow-hidden">
    <!-- Subtle Background Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-brand-gold/20 rounded-full blur-[100px]"></div>

    <div class="max-w-xl mx-auto text-center bg-white p-10 md:p-14 rounded-3xl shadow-2xl relative z-10 border-t-8 border-brand-gold">
      
      <!-- Friendly Down Arrow -->
      <div class="w-20 h-20 bg-brand-navy/5 text-brand-navy rounded-full flex items-center justify-center mx-auto mb-8 shadow-sm animate-bounce">
        <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
      
      <h1 class="text-4xl md:text-5xl font-display text-brand-navy mb-6">Almost There!</h1>
      
      <!-- Premium Info Box instead of a Spammy Warning -->
      <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 mb-8 text-left">
        <h2 class="font-bold text-brand-navy mb-2 flex items-center gap-2">
          <svg class="w-5 h-5 text-brand-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Your details are ready to send
        </h2>
        <p class="text-gray-600 text-sm leading-relaxed">
          We have safely formatted your quote details. To finish up and send them directly to our team, please tap the WhatsApp button below. All your information will be neatly pre-filled!
        </p>
      </div>
      
      <!-- WhatsApp Button -->
      <a id="wa-btn" href="https://wa.me/447354234787" class="bg-[#25D366] text-white px-8 py-5 rounded-full font-bold text-lg hover:bg-[#20bd5a] transition-all shadow-lg hover:shadow-xl hover:-translate-y-1 flex items-center justify-center gap-3 w-full cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
        Send Details via WhatsApp
      </a>
    </div>
  </section>

  <!-- Grabs the saved message and adds it to the button link -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const savedMessage = sessionStorage.getItem('waBookingMessage');
      if (savedMessage) {
        const waBtn = document.getElementById('wa-btn');
        waBtn.href = `https://wa.me/447354234787?text=${encodeURIComponent(savedMessage)}`;
        
        // Optional: clear it after grabbing it so it doesn't stay in memory forever
        sessionStorage.removeItem('waBookingMessage');
      }
    });
  </script>
</Layout>