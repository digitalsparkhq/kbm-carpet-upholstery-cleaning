---
/* src/components/RecentWork.astro */
const projects = [
  {
    title: "The Signature Oven Restoration",
    beforeImg: "/images/oven-before.jpg",
    afterImg: "/images/oven-after.jpg",
  },
  {
    title: "Sanctuary Bedroom Refresh",
    beforeImg: "/images/bed-before.jpg",
    afterImg: "/images/bed-after.jpg",
  },
  {
    title: "Limescale & Basin Detailing",
    beforeImg: "/images/basin-before.jpg",
    afterImg: "/images/basin-after.jpg",
  },
  {
    title: "Bespoke Room Transformation",
    beforeImg: "/images/room-before.jpg",
    afterImg: "/images/room-after.jpg",
  }
];
---

<section class="py-24 bg-white relative overflow-hidden" id="our-work">
  <div class="absolute top-1/2 left-0 -translate-y-1/2 opacity-[0.03] pointer-events-none">
    <svg width="600" height="600" viewBox="0 0 24 24" fill="none" stroke="#616b47" stroke-width="0.5"><path d="M12 3v18M3 12h18"/></svg>
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    
    <div class="text-center mb-20 reveal-on-scroll">
      <span class="text-brand-sage font-bold tracking-widest uppercase text-xs block mb-4">The Miracle Workers</span>
      <h2 class="text-4xl md:text-5xl font-display text-brand-deep mb-6">
        Our Recent <span class="italic text-brand-sage">Transformations</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
        From stubborn limescale to post-construction dust, we take pride in returning spaces to their pristine, "feel-good" state. 
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      {projects.map((project) => (
        <div class="group flex flex-col reveal-on-scroll">
          
          <div class="gallery-trigger relative w-full aspect-[16/10] flex rounded-[2rem] overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 cursor-pointer border border-gray-100"
               data-title={project.title}
               data-before={project.beforeImg}
               data-after={project.afterImg}>
            
            <div class="absolute inset-0 bg-brand-deep/20 group-hover:bg-brand-deep/40 z-20 transition-all duration-500 flex items-center justify-center pointer-events-none">
                <div class="bg-white/20 backdrop-blur-md p-4 rounded-full scale-50 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-500">
                  <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" /></svg>
                </div>
            </div>

            <div class="w-1/2 relative h-full overflow-hidden">
              <img src={project.beforeImg} alt="Before" class="w-full h-full object-cover grayscale-[30%] brightness-[0.7] transition-transform duration-1000 group-hover:scale-110" />
              <div class="absolute top-4 left-4 bg-brand-deep/80 backdrop-blur-sm text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-tighter z-30">Before</div>
            </div>

            <div class="absolute inset-y-0 left-1/2 w-1 bg-white/50 z-30 transform -translate-x-1/2 backdrop-blur-sm"></div>

            <div class="w-1/2 relative h-full overflow-hidden">
              <img src={project.afterImg} alt="After" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />
              <div class="absolute top-4 right-4 bg-brand-sage text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-tighter z-30 shadow-lg">After</div>
              <div class="absolute inset-0 bg-gradient-to-tr from-white/0 via-white/20 to-white/0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 z-20"></div>
            </div>

          </div>

          <h3 class="text-xl font-display italic text-brand-deep mt-6 px-2">{project.title}</h3>
        </div>
      ))}
    </div>

    <div class="mt-20 text-center reveal-on-scroll">
      <button 
        onclick="document.getElementById('booking-modal').showModal()"
        class="inline-flex justify-center items-center px-10 py-4 bg-brand-sage text-white font-bold rounded-full hover:bg-brand-deep transition-all shadow-xl hover:-translate-y-1 cursor-pointer"
      >
        START YOUR TRANSFORMATION
      </button>
    </div>

  </div>
</section>

<div id="lightbox" class="fixed inset-0 z-[100] hidden flex-col items-center justify-center p-4 md:p-12 opacity-0 transition-opacity duration-300" aria-modal="true" role="dialog">
  <div id="lightbox-backdrop" class="absolute inset-0 bg-brand-deep/95 backdrop-blur-xl cursor-pointer"></div>
  
  <button type="button" id="lightbox-close" class="absolute top-6 right-6 text-white hover:text-brand-sage z-[110] cursor-pointer p-2 transition-all">
    <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
  </button>

  <div class="relative z-[105] w-full max-w-6xl transform scale-95 transition-transform duration-300" id="lightbox-content">
    <h3 id="lightbox-title" class="text-2xl md:text-4xl font-display italic text-white mb-8 text-center"></h3>
    
    <div class="relative w-full aspect-[16/9] flex rounded-3xl overflow-hidden border border-white/10 shadow-2xl">
      <div class="w-1/2 relative h-full">
        <img id="lightbox-before" src="" alt="Before" class="w-full h-full object-cover brightness-75" />
        <div class="absolute bottom-6 left-6 bg-brand-deep/80 text-white text-xs font-bold px-4 py-2 rounded-full uppercase">Before</div>
      </div>
      
      <div class="absolute inset-y-0 left-1/2 w-1 bg-brand-sage z-10 transform -translate-x-1/2"></div>
      
      <div class="w-1/2 relative h-full">
        <img id="lightbox-after" src="" alt="After" class="w-full h-full object-cover" />
        <div class="absolute bottom-6 right-6 bg-brand-sage text-white text-xs font-bold px-4 py-2 rounded-full uppercase shadow-lg">After</div>
      </div>
    </div>
  </div>
</div>

<style>
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  
  .img-loaded {
    transform: scale(1) !important;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Scroll Reveal
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('is-revealed');
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));

    // Lightbox
    const triggers = document.querySelectorAll('.gallery-trigger');
    const lightbox = document.getElementById('lightbox');
    const closeBtn = document.getElementById('lightbox-close');
    const backdrop = document.getElementById('lightbox-backdrop');
    const lbTitle = document.getElementById('lightbox-title');
    const lbBefore = document.getElementById('lightbox-before');
    const lbAfter = document.getElementById('lightbox-after');
    const lbContent = document.getElementById('lightbox-content');

    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        lbTitle.textContent = trigger.getAttribute('data-title');
        lbBefore.setAttribute('src', trigger.getAttribute('data-before'));
        lbAfter.setAttribute('src', trigger.getAttribute('data-after'));
        
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
        
        setTimeout(() => {
          lightbox.classList.remove('opacity-0');
          lbContent.classList.add('img-loaded');
        }, 50);
      });
    });

    const closeLightbox = () => {
      lightbox.classList.add('opacity-0');
      lbContent.classList.remove('img-loaded');
      setTimeout(() => {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        document.body.style.overflow = 'auto';
      }, 300);
    };

    closeBtn?.addEventListener('click', closeLightbox);
    backdrop?.addEventListener('click', closeLightbox);
  });
</script>