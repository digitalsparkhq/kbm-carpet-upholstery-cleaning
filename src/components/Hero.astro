---
/* src/components/Hero.astro */
const unsplashKitchen = "https://images.unsplash.com/photo-1604014237800-1c9102c219da?q=80&w=2940&auto=format&fit=crophttps://images.unsplash.com/photo-1556912177-f547cff39411?q=80&w=2940&auto=format&fit=crop";
---

<section class="relative h-[85vh] w-full overflow-hidden bg-brand-deep">
  <div class="absolute inset-0 z-0">
    <img 
      src={unsplashKitchen} 
      alt="Immaculate modern kitchen" 
      class="w-full h-full object-cover object-bottom"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/50 to-transparent"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto h-full px-6 flex items-center">
    <div class="max-w-2xl animate-fade-in-left">
      <span class="text-brand-sky font-bold tracking-[0.3em] uppercase text-[10px] md:text-xs mb-4 block">
        Bespoke Cleaning • Brighton & East Sussex
      </span>
      <h1 class="font-display text-5xl md:text-7xl text-white leading-tight mb-6">
        Spaces you can <br />
        <span class="italic text-brand-sky">feel good</span> in.
      </h1>
      <p class="text-lg md:text-xl text-gray-200 mb-10 max-w-lg leading-relaxed">
        Sian and Kai provide compassionate, thorough cleaning for homes and businesses. We handle the grime so you can breathe easy.
      </p>
      
      <div class="flex mt-6 mb-20 md:mb-0">
  <a href="tel:+447498054153" class="bg-brand-sage text-white px-10 py-4 rounded-full font-bold flex items-center gap-3 hover:bg-white hover:text-brand-sage transition-all shadow-xl group cursor-pointer relative z-30">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:rotate-12 transition-transform">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
    CALL NOW
  </a>
</div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 w-full h-16 md:h-28 bg-white oval-cut"></div>
</section>

<style>
  .oval-cut {
    /* Creates the smooth curved bottom edge */
    clip-path: ellipse(70% 100% at 50% 100%);
  }

  .animate-fade-in-left {
    animation: fadeInLeft 1s ease-out forwards;
  }

  @keyframes fadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>