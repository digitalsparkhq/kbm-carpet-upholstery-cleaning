---
/* src/components/Hero.astro */
// A high-quality image of a clean, modern living room with a prominent rug/carpet
const heroImage = "https://images.unsplash.com/photo-1600121848594-d8644e57abab?q=80&w=2940&auto=format&fit=crop";
---

<section class="relative h-[85vh] w-full overflow-hidden bg-brand-navy">
  <div class="absolute inset-0 z-0">
    <img 
      src={heroImage} 
      alt="Professionally cleaned living room carpet" 
      class="w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-brand-navy/95 via-brand-navy/60 to-transparent"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto h-full px-6 flex items-center">
    <div class="max-w-2xl animate-fade-in-left mt-24 md:mt-0">
      <span class="text-brand-gold font-bold tracking-[0.3em] uppercase text-[10px] md:text-xs mb-4 block">
        Professional Carpet & Upholstery Cleaning • Hull & East Riding
      </span>
      
      <h1 class="font-display text-5xl md:text-7xl text-white leading-tight mb-6">
        Don't replace it, <br />
        <span class="italic text-brand-gold">restore it.</span>
      </h1>
      
      <p class="text-lg md:text-xl text-gray-200 mb-10 max-w-lg leading-relaxed font-light">
        We use powerful industrial extraction to remove deep-down dirt, allergens, and odours. Get a professional deep clean that brings your home back to life.
      </p>
      
      <div class="flex mt-6 mb-20 md:mb-0">
        <a href="tel:+447354234787" class="bg-brand-gold text-brand-navy px-10 py-4 rounded-full font-bold flex items-center gap-3 hover:bg-white hover:text-brand-navy transition-all shadow-xl group cursor-pointer relative z-30 border-2 border-brand-gold hover:border-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:rotate-12 transition-transform">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          CALL NOW
        </a>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 w-full h-16 md:h-28 bg-brand-white oval-cut"></div>
</section>

<style>
  .oval-cut {
    clip-path: ellipse(70% 100% at 50% 100%);
  }

  .animate-fade-in-left {
    animation: fadeInLeft 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-40px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>