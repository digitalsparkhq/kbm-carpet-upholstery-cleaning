---
/* src/components/Hero.astro */
// A high-quality image of a clean, modern living room with a prominent rug/carpet
const heroImage = "https://images.unsplash.com/photo-1600121848594-d8644e57abab?q=80&w=2940&auto=format&fit=crop";
---

<section class="relative h-[85vh] w-full overflow-hidden bg-brand-navy">
  <div class="absolute inset-0 z-0">
    <img 
      src={heroImage} 
      alt="Professionally cleaned living room carpet" 
      class="w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-brand-navy/95 via-brand-navy/60 to-transparent"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto h-full px-6 flex items-center">
    <div class="max-w-2xl animate-fade-in-left mt-24 md:mt-0">
      
      <!-- Pre-title -->
      <span class="text-brand-gold font-bold tracking-[0.3em] uppercase text-[10px] md:text-xs mb-4 block">
        Don't replace it, restore it.
      </span>
      
      <!-- Main Title -->
      <h1 class="font-display text-5xl md:text-7xl text-white leading-tight mb-6">
        Carpet Cleaning <br />
        <span class="italic text-brand-gold">Hull</span>
      </h1>
      
      <!-- Subtitle -->
      <p class="text-base md:text-lg text-gray-200 mb-10 max-w-xl leading-relaxed font-light">
        <strong class="font-semibold text-white">Professional Carpet & Upholstery Cleaning Across Hull & East Yorkshire.</strong><br /><br />
        KBM Cleaning provides professional carpet cleaning in Hull, Beverley, Hessle, Cottingham, Anlaby and surrounding areas. We remove stains, odours and deep-seated dirt using professional equipment.
      </p>
      
      <!-- CTA & Trust Badge Group -->
      <div class="flex flex-wrap items-center gap-4 sm:gap-6 mt-6 mb-20 md:mb-0">
        
        <!-- Call Button -->
        <a href="tel:+447354234787" onclick="window.reportConversion()" class="bg-brand-gold text-brand-navy px-10 py-4 rounded-full font-bold flex items-center gap-3 hover:bg-white hover:text-brand-navy transition-all shadow-xl group cursor-pointer relative z-30 border-2 border-brand-gold hover:border-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:rotate-12 transition-transform">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          CALL NOW
        </a>

        <!-- 5-Star Google Review Badge (SOLID WHITE FIX) -->
        <div class="flex items-center gap-3 bg-white rounded-full px-5 py-3 relative z-30 shadow-xl border border-gray-100">
          <div class="flex text-brand-gold">
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
          </div>
          <span class="text-brand-navy font-bold text-xs sm:text-sm tracking-wide">Rated 5 Stars on Google</span>
        </div>
      </div>
      
    </div>
  </div>

  <div class="absolute bottom-0 left-0 w-full h-16 md:h-28 bg-brand-white oval-cut"></div>
</section>

<style>
  .oval-cut {
    clip-path: ellipse(70% 100% at 50% 100%);
  }

  .animate-fade-in-left {
    animation: fadeInLeft 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-40px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>