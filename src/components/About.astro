---
/* src/components/About.astro */
const stats = [
  { label: "Extraction Power", val: "Industrial" },
  { label: "Reviews", val: "5 Star" },
  { label: "Service Area", val: "Hull & ER" },
  { label: "Process", val: "Eco-Safe" }
];
---

<section class="py-24 bg-brand-navy relative overflow-hidden" id="about">
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="bg-brand-accent/20 backdrop-blur-sm rounded-[3rem] p-10 md:p-16 border border-white/10 text-white flex flex-col lg:flex-row items-center gap-16 shadow-2xl reveal-fade-up">
      
      <div class="lg:w-1/2">
        <span class="uppercase tracking-widest text-xs font-bold text-brand-gold block mb-4">The KBM Standard</span>
        <h2 class="font-display text-4xl md:text-5xl mb-6 italic">Deep clean. Safe products. Professional results.</h2>
        <p class="text-gray-300 leading-relaxed mb-8 text-lg">
          We treat every home like it's our own. No rushed jobs, no mess left behind. We use high-powered hot water extraction systems with heated solutions and high-pressure pumps to lift deep dirt, pet odours, and allergens that cheap cleaners miss.
        </p>

        <div class="grid grid-cols-2 gap-6 mb-10">
          {stats.map(stat => (
            <div class="border-l-2 border-brand-gold pl-4">
              <div class="text-2xl font-bold text-white">{stat.val}</div>
              <div class="text-xs uppercase tracking-wider text-brand-gold">{stat.label}</div>
            </div>
          ))}
        </div>

        <ul class="space-y-4 font-semibold text-brand-white">
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-brand-gold text-brand-navy flex items-center justify-center text-xs">✓</span>
            Industrial Hot Water Extraction
          </li>
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-brand-gold text-brand-navy flex items-center justify-center text-xs">✓</span>
            Stain Treatment Included as Standard
          </li>
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-brand-gold text-brand-navy flex items-center justify-center text-xs">✓</span>
            Eco-Friendly & Pet Safe Solutions
          </li>
        </ul>
      </div>
      
      <div class="lg:w-1/2 relative reveal-pop-up" style="transition-delay: 300ms">
         <div class="rounded-3xl overflow-hidden border-8 border-white/5 shadow-2xl transform -rotate-2 hover:rotate-0 transition-all duration-700">
            <img 
              src="/images/about.jpg" 
              alt="Professional KBM Carpet Cleaning Equipment" 
              class="w-full h-auto scale-110 hover:scale-100 transition-transform duration-1000" 
            />
         </div>
         <div class="absolute -top-6 -left-6 w-32 h-32 bg-brand-gold/10 rounded-full blur-3xl z-0"></div>
      </div>
    </div>
  </div>
</section>