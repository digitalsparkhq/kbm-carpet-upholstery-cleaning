---
/* src/components/Features.astro */
const services = [
  { title: "End of Tenancy", desc: "Our specialty. Guaranteed deposit recovery focus.", icon: "🏠" },
  { title: "Deep / Builders Cleans", desc: "Removing post-construction dust and heavy grime.", icon: "✨" },
  { title: "Carpet Restorative", desc: "Deep extraction for carpets and high-traffic rugs.", icon: "🧼" },
  { title: "Commercial Spaces", desc: "Regular office and retail cleaning for Brighton firms.", icon: "🏢" },
  { title: "Oven & Appliance", desc: "Internal deep cleans for ovens, fridges, and hoods.", icon: "🍳" },
  { title: "Window Cleaning", desc: "Interior glass and frame detailing for a streak-free finish.", icon: "🪟" },
  { title: "Regular Domestic", desc: "Weekly or monthly maintenance for busy households.", icon: "🗓️" },
  { title: "Illness & Support", desc: "Compassionate cleaning for those needing extra help.", icon: "❤️" }
];
---

<section class="py-24 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="text-center max-w-3xl mx-auto mb-20 reveal-fade-up">
      <h2 class="font-display text-4xl md:text-5xl text-brand-deep mb-6">
        Spaces you can <span class="italic text-brand-sage">truly breathe</span> in.
      </h2>
      <p class="text-gray-600 leading-relaxed text-lg">
        Cleaning isn't just about appearances; it's about peace of mind. Sian and Kai treat every home with the care it deserves.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-24">
      {services.map((service, index) => (
        <div 
          class="reveal-pop-up p-8 rounded-3xl bg-brand-light/40 border border-brand-sky/30 hover:border-brand-sage transition-all group hover:-translate-y-2 cursor-default"
          style={`transition-delay: ${index * 100}ms`}
        >
          <div class="text-4xl mb-6 group-hover:scale-125 transition-transform duration-500 inline-block">{service.icon}</div>
          <h3 class="font-display text-xl mb-3 text-brand-deep font-bold">{service.title}</h3>
          <p class="text-sm text-gray-500 leading-relaxed">{service.desc}</p>
        </div>
      ))}
    </div>

    <div class="bg-brand-sage rounded-[3rem] p-10 md:p-16 text-white flex flex-col md:flex-row items-center gap-12 shadow-2xl reveal-fade-up">
      <div class="md:w-1/2">
        <span class="uppercase tracking-widest text-xs font-bold text-brand-sky block mb-4">The KSW Standard</span>
        <h2 class="font-display text-3xl md:text-5xl mb-6 italic">We see what others miss.</h2>
        <p class="text-brand-light/90 leading-relaxed mb-8 text-lg">
          From stubborn limescale on a bathroom tap to hidden dust behind an oven, we restore your home to its best version.
        </p>
        <ul class="grid grid-cols-1 gap-4 font-semibold">
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-white/10 flex items-center justify-center text-brand-sky text-xs">✓</span>
            Full Limescale Removal
          </li>
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-white/10 flex items-center justify-center text-brand-sky text-xs">✓</span>
            Internal Appliance Deep Cleans
          </li>
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-white/10 flex items-center justify-center text-brand-sky text-xs">✓</span>
            Compassionate Mental Health Support
          </li>
        </ul>
      </div>
      
      <div class="md:w-1/2 relative reveal-pop-up" style="transition-delay: 300ms">
         <div class="rounded-3xl overflow-hidden border-8 border-white/10 shadow-2xl transform rotate-2 hover:rotate-0 transition-all duration-700">
            <img 
              src="https://images.unsplash.com/photo-1584622650111-993a426fbf0a?q=80&w=2070&auto=format&fit=crop" 
              alt="Detailed cleaning miracle" 
              class="w-full h-auto scale-110 hover:scale-100 transition-transform duration-1000" 
            />
         </div>
         <div class="absolute -bottom-6 -right-6 w-24 h-24 bg-brand-sky/20 rounded-full blur-2xl z-0"></div>
      </div>
    </div>

  </div>
</section>

<style>
  /* Base hidden states */
  .reveal-fade-up {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal-pop-up {
    opacity: 0;
    transform: scale(0.8);
    transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Active states triggered by JS */
  .reveal-active {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<script is:inline>
  const observerOptions = {
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('reveal-active');
      }
    });
  }, observerOptions);

  document.querySelectorAll('.reveal-fade-up, .reveal-pop-up').forEach(el => {
    observer.observe(el);
  });
</script>