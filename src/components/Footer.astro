---
import { Image } from 'astro:assets';
import myLogo from '../assets/logo.png';
const currentYear = new Date().getFullYear();

// Added the areas array for easy management
const serviceAreas = [
  "Hull", "Beverley", "Cottingham", "Hessle", 
  "Anlaby", "Willerby", "Kirk Ella", "Hedon", 
  "Withernsea", "Market Weighton", "Driffield"
];
---

<footer class="bg-brand-dark text-white pt-20 pb-10 overflow-hidden relative border-t border-brand-gold/10">
  <div class="absolute top-0 right-0 opacity-[0.03] pointer-events-none">
     <svg width="400" height="400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.5"><path d="M12 3v18M3 12h18"/></svg>
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <!-- Updated grid to accommodate 4 columns on large screens -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8 mb-16 text-center sm:text-left items-center sm:items-start">
      
      <!-- Column 1: Brand & Bio -->
      <div class="flex flex-col items-center sm:items-start space-y-6">
        <a href="/" class="block bg-brand-white/5 p-2 rounded-lg w-fit transition-transform hover:scale-105">
            <Image src={myLogo} alt="KBM Logo" class="w-40 h-auto" />
        </a>
        <p class="text-gray-400 text-sm leading-relaxed max-w-sm">
          Professional domestic & commercial carpet and upholstery cleaning in Hull & East Riding. We deliver proper deep cleans that revive your home.
        </p>
        
        <div class="flex gap-5 pt-2">
            <a href="https://wa.me/447354234787" target="_blank" class="text-gray-400 hover:text-[#25D366] transition-all transform hover:-translate-y-1">
              <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.937 3.659 1.432 5.631 1.433h.005c6.554 0 11.89-5.335 11.893-11.892a11.826 11.826 0 00-3.481-8.413z"/></svg>
            </a>
            <a href="https://www.facebook.com/KBMspa/" target="_blank" class="text-gray-400 hover:text-[#1877F2] transition-all transform hover:-translate-y-1">
              <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
        </div>
      </div>

      <!-- Column 2: Navigation -->
      <div class="flex flex-col items-center sm:items-start lg:pl-10">
        <h4 class="font-bold uppercase text-[10px] tracking-widest mb-8 text-brand-gold">Navigation</h4>
        <ul class="space-y-4 text-sm text-gray-400">
          <li><a href="/" class="hover:text-brand-gold transition-colors">Home</a></li>
          <li><a href="/#our-work" class="hover:text-brand-gold transition-colors">Gallery</a></li>
          <li><a href="/#about" class="hover:text-brand-gold transition-colors">About</a></li>
          <li><a href="/contact" class="hover:text-brand-gold transition-colors">Contact</a></li>
          <li><button onclick="document.getElementById('booking-modal').showModal()" class="hover:text-brand-gold transition-colors cursor-pointer">Book Now</button></li>
        </ul>
      </div>

      <!-- Column 3: Areas We Cover (NEW SECTION) -->
      <div class="flex flex-col items-center sm:items-start">
        <h4 class="font-bold uppercase text-[10px] tracking-widest mb-8 text-brand-gold">Areas We Cover</h4>
        <div class="flex flex-wrap justify-center sm:justify-start gap-2 max-w-xs">
          {serviceAreas.map((area) => (
            <span class="bg-white/5 border border-white/10 px-3 py-1.5 rounded-full text-xs text-gray-300 hover:bg-brand-gold hover:text-brand-navy hover:border-brand-gold transition-colors cursor-default">
              {area}
            </span>
          ))}
        </div>
      </div>

      <!-- Column 4: Contact Info -->
      <div class="flex flex-col items-center sm:items-start">
        <h4 class="font-bold uppercase text-[10px] tracking-widest mb-8 text-brand-gold">Get In Touch</h4>
        <ul class="space-y-6 text-sm">
          <li class="flex flex-col lg:flex-row items-center lg:items-start gap-4 group text-center lg:text-left">
            <span class="text-brand-gold bg-white/5 p-2.5 rounded-full group-hover:bg-brand-gold/20 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </span>
            <a href="tel:+447354234787" onclick="window.reportConversion()" class="text-gray-400 hover:text-white transition mt-1">07354 234787</a>
          </li>
          <li class="flex flex-col lg:flex-row items-center lg:items-start gap-4 group text-center lg:text-left">
            <span class="text-brand-gold bg-white/5 p-2.5 rounded-full group-hover:bg-brand-gold/20 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </span>
            <a href="mailto:kbmspa@outlook.com" onclick="window.reportConversion()" class="text-gray-400 hover:text-white transition mt-1">kbmspa@outlook.com</a>
          </li>
          <li class="flex flex-col lg:flex-row items-center lg:items-start gap-4 group text-center lg:text-left">
            <span class="text-brand-gold bg-white/5 p-2.5 rounded-full group-hover:bg-brand-gold/20 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </span>
            <span class="text-gray-400 mt-1">Kingston upon Hull,<br />East Riding, HU12</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright Bar -->
    <div class="border-t border-white/5 pt-10 flex flex-col md:flex-row justify-between items-center gap-6 text-center md:text-left">
      <p class="text-xs text-gray-500 font-light">
        &copy; {currentYear} KBM Carpet Upholstery & Cleaning Services. All rights reserved.
      </p>
      <div class="text-[11px] uppercase tracking-widest text-gray-500">
        Designed by <a href="https://digitalsparkhq.com/" target="_blank" class="text-brand-gold hover:text-white transition-colors font-bold underline underline-offset-4">Digital Spark HQ</a>
      </div>
    </div>
  </div>
</footer>