---
/* src/components/Testimonials.astro */
const testimonials = [
  { 
    name: "Fern Latham", 
    tag: "Rental Restoration", 
    text: "I had to move out of a rented place and my carpets had 3 years worth of dirt built up. Including black tattooing ink and coloured paint. Honestly thought I'd have to pay to replace it. Pleasantly surprised that they got everything up and the carpet looked brand new!" 
  },
  { 
    name: "Reemstays", 
    tag: "Highly Recommended", 
    text: "Amazing service, reliable and very reasonably priced for the service they provide! I would highly recommend this service and I will be using this service in the future!" 
  },
  { 
    name: "Melissa McCann", 
    tag: "Sofa Revival", 
    text: "Had KBM clean my large corner sofa with amazing results leaving my sofa looking brand new again and smelling so fresh! Would highly recommend with reasonable prices too." 
  },
  { 
    name: "Emma Crook", 
    tag: "5-Star Professionalism", 
    text: "These lads were so professional and did a great job. My dining chairs look great. Last company did a really poor job only back in September. Anyone thinking of getting them done, get booked in!" 
  },
  { 
    name: "Danielle Williams", 
    tag: "Pet & Kid Friendly", 
    text: "My carpets weren't in the best state after two years of kids and animals but after today they look almost new again. Massive thank you, will definitely book again." 
  }
];
---

<section class="py-24 bg-brand-navy/5 relative overflow-hidden min-h-[900px] flex flex-col justify-center">
  
  <div class="absolute inset-0 pointer-events-none select-none z-0">
    <svg class="absolute top-10 right-[10%] text-brand-navy opacity-[0.05] -rotate-12 w-48 h-48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.5"><path d="M3 21h18M6 21V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v17M9 7h6M9 12h6M12 17v4"/></svg>
    <svg class="absolute bottom-20 left-[5%] text-brand-gold opacity-[0.08] rotate-12 w-40 h-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.5"><path d="M12 11h9M12 13h7M7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2Z"/><path d="M11 12l2.5 2.5 5-5"/></svg>
    <svg class="absolute top-1/4 left-[5%] text-brand-navy opacity-[0.05] w-24 h-24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="12" cy="12" r="3"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="19" r="2"/></svg>
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10 w-full">
    <div class="text-center mb-16">
      <span class="text-brand-gold font-bold tracking-widest uppercase text-xs block mb-4">Hull & East Riding Reviews</span>
      <h2 class="font-display text-4xl md:text-5xl text-brand-navy leading-tight">What Our <span class="italic text-brand-gold">Clients Say</span></h2>
    </div>

    <div class="relative px-0 md:px-16">
      <button id="prev-btn" class="absolute left-0 top-1/2 -translate-y-1/2 z-40 bg-white w-12 h-12 rounded-full shadow-xl text-brand-navy hover:bg-brand-gold hover:text-brand-navy transition-all cursor-pointer flex items-center justify-center border border-brand-gold/20 active:scale-90">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button id="next-btn" class="absolute right-0 top-1/2 -translate-y-1/2 z-40 bg-white w-12 h-12 rounded-full shadow-xl text-brand-navy hover:bg-brand-gold hover:text-brand-navy transition-all cursor-pointer flex items-center justify-center border border-brand-gold/20 active:scale-90">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m9 18 6-6-6-6"/></svg>
      </button>

      <div id="carousel-viewport" class="overflow-hidden rounded-[3rem]">
        <div id="carousel-track" class="flex transition-transform duration-500 ease-out">
          </div>
      </div>
    </div>

    <div class="flex justify-center gap-3 mt-12 mb-16" id="dots-wrapper">
      {testimonials.map((_, i) => (
        <button class="dot-nav w-3 h-3 rounded-full border-2 border-brand-gold/40 transition-all duration-300 cursor-pointer" data-index={i}></button>
      ))}
    </div>

    <div class="text-center">
      <button onclick="document.getElementById('booking-modal').showModal()" class="bg-brand-navy text-brand-gold px-12 py-5 rounded-full font-bold shadow-xl hover:scale-105 transition-transform cursor-pointer border-2 border-brand-gold hover:bg-brand-gold hover:text-brand-navy uppercase tracking-wider">
        Message US for a quote
      </button>
    </div>
  </div>
</section>

<script is:inline define:vars={{ testimonials }}>
  const track = document.getElementById('carousel-track');
  const dots = document.querySelectorAll('.dot-nav');
  const nextBtn = document.getElementById('next-btn');
  const prevBtn = document.getElementById('prev-btn');
  
  let currentIndex = 0;
  const totalOriginal = testimonials.length;

  function createCard(item) {
    return `<div class="flex-shrink-0 w-full md:w-1/3 px-4">
        <div class="bg-white p-8 md:p-10 rounded-[2.5rem] shadow-sm border border-brand-navy/10 flex flex-col h-[420px] justify-between transition-all hover:shadow-md">
          <div>
            <div class="flex justify-between items-start mb-6">
              <span class="inline-block px-4 py-1.5 rounded-full bg-brand-gold/20 text-brand-navy text-[10px] font-bold uppercase tracking-wider">${item.tag}</span>
              <div class="text-brand-gold flex gap-0.5">
                ${Array(5).fill('<svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>').join('')}
              </div>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed italic font-light">"${item.text}"</p>
          </div>
          <div class="flex items-center gap-4 border-t pt-6 border-gray-100">
            <div class="w-12 h-12 rounded-full bg-brand-navy text-brand-gold flex items-center justify-center font-bold text-lg shadow-inner">${item.name[0]}</div>
            <span class="font-bold text-brand-navy">${item.name}</span>
          </div>
        </div>
      </div>`;
  }

  // Populate clones for infinite loop
  const originals = testimonials.map(item => createCard(item)).join('');
  const clonesBefore = testimonials.slice(-3).map(item => createCard(item)).join('');
  const clonesAfter = testimonials.slice(0, 3).map(item => createCard(item)).join('');
  track.innerHTML = clonesBefore + originals + clonesAfter;

  function updateSlider(index, animate = true) {
    const cardWidth = track.querySelector('div').offsetWidth;
    currentIndex = index;
    
    track.style.transition = animate ? 'transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)' : 'none';
    const targetTranslate = -( (index + 3) * cardWidth );
    track.style.transform = `translateX(${targetTranslate}px)`;

    const dotIndex = ( (index % totalOriginal) + totalOriginal ) % totalOriginal;
    dots.forEach((dot, i) => {
      dot.classList.toggle('bg-brand-gold', i === dotIndex);
      dot.classList.toggle('w-10', i === dotIndex);
      dot.classList.toggle('w-3', i !== dotIndex);
    });
  }

  track.addEventListener('transitionend', () => {
    if (currentIndex >= totalOriginal) updateSlider(0, false);
    if (currentIndex <= -1) updateSlider(totalOriginal - 1, false);
  });

  // Event Listeners
  prevBtn.onclick = () => updateSlider(currentIndex + 1); 
  nextBtn.onclick = () => updateSlider(currentIndex - 1); 
  dots.forEach((dot, i) => dot.onclick = () => updateSlider(i));

  updateSlider(0, false);
  window.addEventListener('resize', () => updateSlider(currentIndex, false));
</script>