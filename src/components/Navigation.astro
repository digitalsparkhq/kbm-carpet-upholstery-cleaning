      <a href="/about" class={`hover:text-brand-sage transition-colors ${currentPath === "about" ? "text-brand-sage" : ""}`}>About</a>
      <a href="/contact" class={`hover:text-brand-sage transition-colors ${currentPath === "contact" ? "text-brand-sage" : ""}`}>Contact</a>
    </nav>

    <div class="flex flex-col gap-10 items-center">
      <button onclick="document.getElementById('booking-modal').showModal(); document.getElementById('side-menu').classList.add('translate-x-full')" class="w-full bg-brand-sage text-white py-4 rounded-full font-bold shadow-lg">
