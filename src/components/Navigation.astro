---
import { Image } from 'astro:assets';
import myLogo from '../assets/logo.png';
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname === "/" ? "" : pathname.replace(/^\//, '');
---

<header class="bg-white border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    
    <div class="flex items-center gap-8">
      <a href="/" class="bg-brand-white p-1 rounded-lg shadow-sm block transition-transform hover:scale-105 border border-gray-100">
        <Image src={myLogo} alt="KBM Logo" class="w-32 md:w-40 h-auto" />
      </a>

      <nav class="hidden lg:flex items-center gap-8 font-semibold text-brand-navy">
        <a href="/" class={`relative pb-1 hover:text-brand-gold transition-all ${currentPath === "" ? "text-brand-gold border-b-2 border-brand-gold" : ""}`}>Home</a>
        <a href="/#our-work" class="relative pb-1 hover:text-brand-gold transition-all">Gallery</a>
        <a href="/#about" class="relative pb-1 hover:text-brand-gold transition-all">About</a>
        <a href="/contact" class={`relative pb-1 hover:text-brand-gold transition-all ${currentPath === "contact" ? "text-brand-gold border-b-2 border-brand-gold" : ""}`}>Contact</a>
      </nav>
    </div>

    <div class="flex items-center gap-6">
      <div class="hidden lg:flex items-center gap-6">
        <a href="tel:+447354234787" class="flex items-center gap-2 font-bold text-brand-navy hover:text-brand-gold transition-colors whitespace-nowrap">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-gold"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          07354 234787
        </a>

        <div class="flex items-center gap-4 border-x px-6 border-gray-200">
          <a href="https://wa.me/447354234787" target="_blank" class="text-gray-400 hover:text-[#25D366] transition-colors hover:scale-110">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.937 3.659 1.432 5.631 1.433h.005c6.554 0 11.89-5.335 11.893-11.892a11.826 11.826 0 00-3.481-8.413z"/></svg>
          </a>
          <a href="https://www.facebook.com/KBMspa/" target="_blank" class="text-gray-400 hover:text-[#1877F2] transition-colors hover:scale-110">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        </div>

        <button 
          onclick="document.getElementById('booking-modal').showModal()"
          class="bg-brand-navy text-brand-gold px-8 py-3 rounded-full text-sm font-bold shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all cursor-pointer border border-brand-gold/20"
        >
          BOOK NOW
        </button>
      </div>

      <button id="menu-open" class="lg:hidden p-2 text-brand-navy cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <div id="side-menu" class="fixed inset-y-0 right-0 w-80 bg-white shadow-2xl transform translate-x-full transition-transform duration-300 z-[60] p-8 flex flex-col">
    <button id="menu-close" class="self-end p-2 text-brand-navy hover:rotate-90 transition-all duration-300 cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    
    <nav class="mt-12 flex flex-col gap-6 text-2xl font-display italic text-brand-navy border-b border-gray-100 pb-8 mb-8">
      <a href="/" class={`hover:text-brand-gold transition-colors ${currentPath === "" ? "text-brand-gold" : ""}`}>Home</a>
      <a href="/#our-work" class="hover:text-brand-gold transition-colors" id="mobile-gallery-link">Gallery</a>
      <a href="/#about" class="hover:text-brand-gold transition-colors" id="mobile-about-link">About</a>
      <a href="/contact" class={`hover:text-brand-gold transition-colors ${currentPath === "contact" ? "text-brand-gold" : ""}`}>Contact</a>
    </nav>

    <div class="flex flex-col gap-10 items-center">
      <button onclick="document.getElementById('booking-modal').showModal(); document.getElementById('side-menu').classList.add('translate-x-full')" class="w-full bg-brand-navy text-brand-gold py-4 rounded-full font-bold shadow-lg border border-brand-gold/20">
        BOOK NOW
      </button>
      
      <div class="flex gap-6 justify-center items-center w-full border-t border-gray-100 pt-8">
        <a href="https://wa.me/447354234787" target="_blank" class="text-gray-400 hover:text-[#25D366]"><svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.937 3.659 1.432 5.631 1.433h.005c6.554 0 11.89-5.335 11.893-11.892a11.826 11.826 0 00-3.481-8.413z"/></svg></a>
        <a href="https://www.facebook.com/KBMspa/" target="_blank" class="text-gray-400 hover:text-[#1877F2]"><svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
      </div>

      <a href="tel:+447354234787" class="flex items-center gap-2 font-bold text-xl text-brand-navy whitespace-nowrap">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-gold"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        07354 234787
      </a>
    </div>
  </div>
</header>

<script>
  const openBtn = document.getElementById('menu-open');
  const closeBtn = document.getElementById('menu-close');
  const menu = document.getElementById('side-menu');
  const mobileGalleryLink = document.getElementById('mobile-gallery-link');

  openBtn?.addEventListener('click', () => menu?.classList.remove('translate-x-full'));
  closeBtn?.addEventListener('click', () => menu?.classList.add('translate-x-full'));
  
  // Close menu when clicking gallery link on mobile
  mobileGalleryLink?.addEventListener('click', () => menu?.classList.add('translate-x-full'));
</script>