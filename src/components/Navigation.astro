---
import { Image } from 'astro:assets';
import myLogo from '../assets/logo.png';
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname === "/" ? "" : pathname.replace(/^\//, '');
---

<header class="bg-white border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    
    <div class="flex items-center gap-8">
      <a href="/" class="bg-brand-light p-2 rounded-lg shadow-inner block transition-transform hover:scale-105">
        <Image src={myLogo} alt="KSW Logo" class="w-32 md:w-40 h-auto" />
      </a>

      <nav class="hidden lg:flex items-center gap-8 font-semibold text-brand-deep">
        <a href="/" class={`relative pb-1 hover:text-brand-sage transition-all ${currentPath === "" ? "text-brand-sage border-b-2 border-brand-sage" : ""}`}>Home</a>
        <a href="/about" class={`relative pb-1 hover:text-brand-sage transition-all ${currentPath === "about" ? "text-brand-sage border-b-2 border-brand-sage" : ""}`}>About</a>
        <a href="/contact" class={`relative pb-1 hover:text-brand-sage transition-all ${currentPath === "contact" ? "text-brand-sage border-b-2 border-brand-sage" : ""}`}>Contact</a>
      </nav>
    </div>

    <div class="flex items-center gap-6">
